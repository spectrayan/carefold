# Carefold Docker Compose settings. Copy to deploy/docker/.env (never commit it):
#
#   cp deploy/docker/.env.example deploy/docker/.env
#
# Vault key (KEK), required. Chats are saved encrypted with a key derived from
# it, so the backend does not start without it. Generate it once:
#
#   openssl rand -hex 32
#   # or: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# and paste the 64 hex characters below. Back it up somewhere safe: if it is
# lost or changed, saved chats can no longer be read.
CAREFOLD_VAULT_KEK=

# Optional overrides (defaults shown).
# CAREFOLD_OLLAMA_URL=http://ollama:11434/v1
# CAREFOLD_DB_PATH=/data/checkpoints.sqlite
# CAREFOLD_AUDIT_LOG_PATH=/data/audit.jsonl
