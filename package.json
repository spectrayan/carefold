{
  "name": "carefold-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Carefold: Local-first runtime and marketplace for specialist health agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "check:licenses": "node scripts/licenses.mjs --check",
    "fix:licenses": "node scripts/licenses.mjs --fix",
    "build": "pnpm -r --if-present run build",
    "dev:backend": "backend/.venv/bin/python3 -m uvicorn carefold.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "pnpm --filter @carefold/web dev",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "node tests/e2e/runner.js",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
