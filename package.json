{
  "name": "carefold-monorepo",
  "version": "0.4.0-beta.1",
  "private": true,
  "description": "Carefold: Local-first runtime and marketplace for specialist health agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "check:licenses": "node scripts/licenses.mjs --check",
    "fix:licenses": "node scripts/licenses.mjs --fix",
    "generate:readme": "node scripts/generate-readme-table.mjs",
    "check:readme": "node scripts/generate-readme-table.mjs --check",
    "start": "bash scripts/start.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "build": "pnpm -r --if-present run build",
    "dev:backend": "backend/.venv/bin/python3 -m uvicorn carefold.main:app --host 0.0.0.0 --port 8010 --reload",
    "dev:web": "pnpm --filter @carefold/web dev",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "node tests/e2e/runner.js",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.11"
  }
}
