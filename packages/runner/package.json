{
  "name": "@carefold/runner",
  "version": "0.4.0-beta.1",
  "description": "Core agent and skill runner, safety refusal gate, closed tool sandbox, and audit engine for Carefold",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
